# ---- Python 环境与缓存 ----
.venv/
.venv-*/
.venv.backup-*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- 本地运行数据（含数据库、报告、缓存与日志）----
data/*
!data/.gitkeep
*.db
*.sqlite3
*.bak
*.log
.ci-data/
data-slim*/

# ---- 密钥与本地配置：绝不提交 ----
.env
.env.*
!.env.example

# ---- 前端依赖与构建输入 ----
node_modules/
# 构建产物已提交（issuedoctor/static），普通用户无需 Node.js

# ---- 临时目录 ----
tmp/
.tmp/
.pytest-tmp/

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
